# Copy to `.env` for local runs (never commit `.env`).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/daghep_dev
PORT=8080
# The web app's origin: CORS, same-origin checks and post-sign-in redirects.
# An https origin makes cookies `Secure`.
FRONTEND_ORIGIN=http://localhost:3000
RUST_LOG=info
# Google sign-in: set all three or none (without them sign-in answers 503).
# The secret comes from Google Cloud console -> Credentials; never commit it.
# GOOGLE_CLIENT_ID=669288809087-96o9da5roaa70da6m0grt0102ggih5oo.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
